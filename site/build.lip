;; site/build.lip -- generate the blip website into site_out/.
;;
;; Content stays Markdown; programs/markdown.lip renders it to HTML, so the
;; same renderer the programs_run gate checks is the one the site ships.

(require "../programs/markdown.lip")

(define (render-page title md-text)
  (use (read-file "site/layout.html")
    (string-replace (string-replace read-file "{{title}}" title) "{{body}}"
      (md-render (string-split md-text "\n")))))

;; index
(use (read-file "site/content/index.md")
  (use (write-file "site_out/index.html"
          (render-page "blip — a Lisp dialect in V" read-file))
    (print "wrote site_out/index.html")))

;; about
(use (read-file "site/content/about.md")
  (use (write-file "site_out/about.html"
          (render-page "About — blip" read-file))
    (print "wrote site_out/about.html")))

;; getting started
(use (read-file "site/content/getting-started.md")
  (use (write-file "site_out/getting-started.html"
          (render-page "Getting started — blip" read-file))
    (print "wrote site_out/getting-started.html")))

;; tour
(use (read-file "site/content/tour.md")
  (use (write-file "site_out/tour.html"
          (render-page "The tour — blip" read-file))
    (print "wrote site_out/tour.html")))

;; cli
(use (read-file "site/content/cli.md")
  (use (write-file "site_out/cli.html"
          (render-page "CLI reference — blip" read-file))
    (print "wrote site_out/cli.html")))

;; embedding
(use (read-file "site/content/embedding.md")
  (use (write-file "site_out/embedding.html"
          (render-page "Embedding — blip" read-file))
    (print "wrote site_out/embedding.html")))

;; status
(use (read-file "site/content/status.md")
  (use (write-file "site_out/status.html"
          (render-page "Status — blip" read-file))
    (print "wrote site_out/status.html")))
