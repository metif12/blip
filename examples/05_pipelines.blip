;; examples/05_pipelines.blip
;; Pipes, labelled arguments, structs with opacity, and macros.
;; The everyday layer: what lets a 300-line program be written with NO macros.

;; =====================================================================
;; pipelines
;; =====================================================================
;; Three forms, because people arrive with different muscle memory.

;; ->> threads LAST: value becomes the final argument. The common case.
(->> [1 2 3]
     (filter odd?)
     (map (fn [x] (* x x)))
     (fold + 0))                 ;=> 35

;; -> threads FIRST: value becomes the first argument.
(-> {:a 2 :b 3}
    (get :a)
    (+ 10))                      ;=> 12

;; |> is dual-mode, and doubles as a debugger.
;; If the right side is a call, the value goes in as the FIRST argument; if it
;; is not a call, it becomes one.
(->> "hello" |> string-upcase |> string-length)   ;=> 5
(->> [3 1 2] |> sort |> reverse)                  ;=> [3 2 1]

;; `echo` inside a pipeline taps a value without restructuring the pipeline.
;; This costs nothing and is the single most useful debugging feature here.
(->> [1 2 3 4 5]
     |> echo                   ; prints the value at this point
     (filter odd?)
     |> echo
     (fold + 0))                ;=> 9

;; =====================================================================
;; labelled arguments
;; =====================================================================
;; Positional underneath, so this is pure sugar -- but it is the best fix for
;; argument-order readability, and it survives reordering.

(def (connect #:host [h "localhost"] #:port [p 8080] #:timeout [t 30])
  (format "~a:~a/~as" h p t))

(connect)                                    ;=> "localhost:8080/30s"
(connect #:port 9000)                        ;=> "localhost:9000/30s"
(connect #:timeout 5 #:host "example.com")   ; order does not matter

;; =====================================================================
;; structs
;; =====================================================================

(struct Point (x y))
(Point 1 2)                  ;=> (Point 1 2)
(def p (Point 1 2))       ; bound BEFORE it is read: the next three lines used
(p.x)                        ; field read: 1
(point? (Point 1 2))         ;=> #t
(point-x (Point 1 2))        ;; => accessor: 1

;; immutable structs: updating returns a new value, leaving the original alone
(def q p.y := 99)         ; q is (Point 1 99), p is still (Point 1 2)

;; #:mutable for the rare in-place case
(struct Counter (n) #:mutable)
(def c (Counter 0))
(set-counter-n! c 5)               ; the mutator is set-STRUCTNAME-FIELD!
(c.n)                        ;=> 5

;; --- structs are callable: a struct used in function position is a lookup ---
;; (:kind {:kind :dog}) => :dog

;; =====================================================================
;; opaque types: encapsulation without a class system
;; =====================================================================
;; The type name is public; the constructor is not. So invariants hold, and
;; there is no interface, no multiple inheritance, and no metaclass.
;;
;; Cost: ~50 lines of export metadata instead of a type system.

(struct PositiveInt (n) #:opaque)

(def (positive-int n)
  (if (> n 0)
      (ok (PositiveInt n))
      (err 'not-positive)))

;; The smart constructor is the ONLY way in, so the invariant cannot be broken:
(match* (list (positive-int 5) (positive-int -1))
  [((ok (PositiveInt n)) _) n]     ;=> 5
  [(_ bad)               bad])     ;=> not-positive

;; =====================================================================
;; macros: available, but not needed for any of the above
;; =====================================================================
;; Everything so far used no macros at all. That is the point.

;; Define a macro: defmacro runs at compile time and returns code.
(defmacro unless-zero (value body)
  ;; value and body are the unevaluated arguments
  (list 'if (list '= value 0) '(begin) body))

;; macex1 expands one step -- the debugging window a macro language needs
(println (macex1 (unless-zero 0 (println "never"))))
;=> (if (= 0 0) (begin) (println "never"))

;; quasiquote builds code without nested list constructors
(defmacro my-when (test . body)
  `(if ,test (begin ,@body) (begin)))

(println (macex (my-when #t (println "a") (println "b"))))
;=> (if #t (begin (println "a") (println "b")) (begin))

;; gensym for generated names -- the fix for capture, which is the sharp edge
;; of an unhygienic macro system
(defmacro define-constantly (name value)
  (let [tmp (gensym 'tmp)]
    `(let ([,tmp ,value])
       (def ,name ,tmp))))

;; `dotimes` is itself a macro; `swap` and `compose` likewise. The standard
;; library is built from these, not from primitives.

;; --- and a genuinely macro-shaped problem: an assert with no cost when on ---
(defmacro debug-check (test)
  `(if *debug* (begin (println "check" ',test))))

;; =====================================================================
;; a program that uses none of the above macros
;; =====================================================================

;; Word frequency, top three. No macros. No nesting. No closures-per-element.
;; `take` takes (coll n), so it is threaded with `->` rather than `->>`: the
;; value has to land in the FIRST slot, and `->>` puts it in the last.
(def (top-words text n)
  (-> (->> (string-split text " ")
           (filter string-not-blank?)
           (map string-downcase)
           (frequencies)
           (sort-by (fn (e) (- (get e 1)))))
      (take n)))

(def report
  (top-words "the quick brown fox jumps over the lazy dog the end the end" 3))

(println (map car report))          ;=> ("the" "end" "quick")

(println "pipelines ok")

;; =====================================================================
;; result pipelines: every branch asserted
;; =====================================================================
;; The combinators are ordinary std definitions (lib/std.blip), so this
;; section runs the same code on the machine and under node. Each branch
;; is asserted: ok, err, and miss-falls-through.

(def (half-if-even n)
  (if (even? n) (ok (/ n 2)) (err 'odd)))

;; `use` binds the ok value and skips the body on err:
(def (describe n)
  (use (half-if-even n)
    (string-append "half is " (number->string half-if-even))))

(describe 8)                     ;=> "half is 4"
(describe 7)                     ;=> (err odd)

;; map-result over both outcomes; an (err _) from f passes through:
(map-result (half-if-even 8) (fn [x] (* x 10)))     ;=> (ok 40)
(map-result (half-if-even 7) (fn [x] (* x 10)))     ;=> (err odd)
(map-result (half-if-even 8) (fn [x] (err 'nope)))  ;=> (err nope)

(unwrap-or (half-if-even 8) 0)   ;=> 4
(unwrap-or (half-if-even 7) 0)   ;=> 0

(flatten-result (ok (ok 1)))       ;=> (ok 1)
(flatten-result (ok (err 'inner))) ;=> (err inner)
(flatten-result (ok 1))           ;=> (ok 1)
(flatten-result (err 'outer))     ;=> (err outer)

(all-results (ok 1) (ok 2))       ;=> (ok [1 2])
(all-results (ok 1) (err 'e))     ;=> (err e)
(all-results)                     ;=> (ok [])

(lazy-unwrap (ok 1) (fn [] 0))                  ;=> 1
(lazy-unwrap (err 'e) (fn [] 0))                ;=> 0
(lazy-map-result (ok 2) (fn [x] (* x 10)))      ;=> (ok 20)
(lazy-map-result (err 'e) (fn [x] (/ x 0)))     ;=> (err e)

;; the err branch matches, and a miss falls through:
;; the err branch names the reason, and a miss falls through. Result
;; constructors cannot discriminate in patterns -- a bare symbol binds --
;; so the err test reads the predicate, and the miss test uses a shape no
;; subject can fake: a list pattern never matches a non-list.
;; a miss falls through. The catch-all binds rather than matches -- a bare
;; symbol always binds -- so the first clause carries the literal that
;; misses, exactly like 03_match's `[(5 _) ...]`. (Patterns cannot
;; discriminate (ok _) from (err _): there is no literal-symbol match, so
;; the err branch above reads the predicate, not a pattern.)
(assert (equal? (match* (list (half-if-even 8) 99)
                  [((ok 100) _) 'worked]
                  [(_ miss) miss])
                99)
  "a match* miss falls through to the next clause")

(println "results ok")

;; =====================================================================
;; seq: zipping, indexing, chunking (ordinary std, lists in and out)
;; =====================================================================

(zip '(1 2 3) '(a b c))          ;=> ((1 a) (2 b) (3 c))
(zip '(1 2) '(a b c))            ;=> ((1 a) (2 b))
(zip '() '(a b))                 ;=> ()
(enumerate '(a b c))             ;=> ((0 a) (1 b) (2 c))
(enumerate '())                  ;=> ()
(partition 2 '(1 2 3 4))         ;=> ((1 2) (3 4))
(partition 2 '(1 2 3))           ;=> ((1 2) (3))
(partition 3 '(1 2 3))           ;=> ((1 2 3))
(partition 2 '())                ;=> ()

;; Numbered report lines: enumerate, then render each pair.
(def (numbered lines)
  (map (fn [p] (string-append (number->string (car p)) ". " (car (cdr p))))
       (enumerate lines)))

(numbered '("parse" "check" "emit"))  ;=> ("0. parse" "1. check" "2. emit")

;; Paired columns: zip, then render each pair.
(def (pair-up names scores)
  (map (fn [p] (string-append (car p) ": " (number->string (car (cdr p)))))
       (zip names scores)))

(pair-up '("ada" "bob") '(10 20))     ;=> ("ada: 10" "bob: 20")