;; lib/std.blip -- the blip standard library, in blip.
;;
;; Loaded by `blip run` and by the REPL before your program, so a program does not
;; have to say `(require "std.blip")` for names everybody assumes exist. That is
;; the same rule every language with a prelude follows, and it is what lets the
;; examples in examples/ read the way they do: `(parse-in "key: value")` is a
;; call, not a definition the reader has to scroll past.
;;
;; Everything here is ordinary blip. There is no special form in this file, which
;; is the point: if the standard library needs a new feature, the feature is
;; missing rather than the library being special.
;;
;; The Result-returning names are the convention the language settles on: a
;; function that can fail for an expected reason returns `(ok v)` or `(err 'why)`,
;; and `use` binds the values without a staircase. A function that fails for an
;; impossible reason calls `raise`.

;; ---------------------------------------------------------------- results

(def (identity x) x)

;; err-message reads the message out of an `(err msg)` value. `raise` builds one
;; and `try`'s #:catch matches against it, so this is how a handler reads what
;; went wrong.
(def (err-message e)
  (assert (err? e) "err-message needs an (err ...) value")
  (get e 1))

;; The Result combinators are ordinary blip. The machine keeps only
;; construction and observation (`ok`, `err`, `ok?`, `err?`, `ok-value`,
;; `err-value`); everything that maps over a Result is defined here, so both
;; engines run the same code. A non-Result passes through `map-result` and
;; `flatten-result` untouched, exactly as the machine builtins did: only an
;; `(ok _)` is mapped, only an `(err _)` is an error.

;; map-result turns (ok v) into (ok (f v)) and passes anything else through
;; untouched -- including an (err _) from f itself, which is returned as is
;; rather than wrapped.
(def (map-result r f)
  (if (ok? r)
      (let ([v (f (ok-value r))])
        (if (err? v) v (ok v)))
      r))

;; unwrap-or takes the value out, or the fallback when there is none. The
;; parameter is not named `default`: that is a reserved word in JavaScript,
;; and the emitter compiles this file too.
(def (unwrap-or r fallback)
  (if (ok? r) (ok-value r) fallback))

;; flatten-result peels one level: (ok (ok 1)) is (ok 1), and so is
;; (ok (err 'inner))'s inner. Anything else is already flat.
(def (flatten-result r)
  (if (ok? r)
      (let ([inner (ok-value r)])
        (if (ok? inner) inner (if (err? inner) inner r)))
      r))

;; all-results collects every value into a vector, or returns the first
;; error. The walk is quadratic in the number of results -- vector-append
;; copies -- which is the price of building a vector without `apply`, and
;; `apply` does not splice under node the way the machine splices.
(def (all-results . rs)
  (all-results-from rs (vector)))

;; all-results-from is the carrying half of all-results, kept under its own
;; name so the name a program writes stays the name that reads well.
(def (all-results-from rs acc)
  (if (null? rs)
      (ok acc)
      (let ([first (car rs)])
        (if (ok? first)
            (all-results-from (cdr rs) (vector-append acc (vector (ok-value first))))
            first))))

;; lazy-unwrap runs the thunk only on err: the default is computed nowhere
;; else, because in a Lisp every argument is evaluated eagerly.
(def (lazy-unwrap r thunk)
  (if (ok? r) (ok-value r) (thunk)))

;; lazy-map-result maps over an (ok _) and passes an (err _) straight
;; through, like map-result. The name states the intent at the call site.
(def (lazy-map-result r f)
  (map-result r f))

;; ---------------------------------------------------------------- parsing

;; parse-in reads "key: value" and returns (ok key value). It is the smallest
;; honest demonstration of a multi-value Result, which is what `use` exists for.
(def (parse-in text)
  ;; `assert`, not `let assert`. `let assert [PATTERN VALUE] body` matches a
  ;; PATTERN against a VALUE, and `(string? text)` binds `text` from the subject
  ;; rather than testing the parameter -- so it never tests anything and the body
  ;; referred to a name nothing had bound.
  (assert (string? text) "parse-in needs a string")
  (let parts (string-split text ":")
    (cond [(= (length parts) 2) (ok (string-trim (list-ref parts 0))
                                    (string-trim (list-ref parts 1)))]
          [else (err 'malformed)])))

;; ---------------------------------------------------------------- symbols

;; lookup-sym finds a name in a small table of symbols. `nil` means absent, which
;; is what match* wants to tell apart from a found-and-wrong value.
(def (lookup-sym name)
  (cond [(equal? name 'alpha) (ok 'alpha)]
        [(equal? name 'beta) (ok 'beta)]
        [else nil]))

;; validate says whether a looked-up symbol is usable.
(def (validate name)
  (cond [(equal? name 'alpha) (ok nil)]
        [(equal? name 'beta) (err 'unknown-symbol)]
        [else (err 'unknown-symbol)]))

;; ---------------------------------------------------------------- resources

;; A connection is a table, so a test can build one by hand and a program can
;; inspect one. A struct would be better once modules can hide constructors; a
;; table is honest about how little this is.
(def (connect target)
  (cond [(string-not-blank? target) (ok {:host target :session nil})]
        [else (err 'bad-target)]))

(def (authenticate conn :user [user "anonymous"] :pass [pass ""])
  (cond [(equal? user "anonymous") (err 'no-credentials)]
        [(not (equal? pass "s3cret")) (err 'bad-password)]
        [else (ok conn)]))

(def (open-transaction conn)
  (cond [(nil? (get conn :session)) (err 'not-authenticated)]
        [else (ok conn)]))

(def (execute conn sql)
  (cond [(nil? (get conn :session)) (err 'not-authenticated)]
        [else (ok sql)]))

(def (commit conn)
  (cond [(nil? (get conn :session)) (err 'not-authenticated)]
        [else (ok 'committed)]))

;; ---------------------------------------------------------------- arrays

;; array-append! pushes every element of src onto the end of dst, in order, and
;; returns dst. `array-push!` adds ONE value per call, so appending a whole array
;; is an iteration over src's indexes -- which is all this wrapper is, walking
;; the indexes with a tail call rather than a `loop` form, because the prelude is
;; also compiled by the JS emitter and a `loop` there is refused by name.
(def (array-append! dst src)
  (array-append!-from dst src 0))

;; The index-carrying half of `array-append!`, kept under its own name so the
;; name a program writes stays the name that reads well at the call site.
(def (array-append!-from dst src i)
  (cond [(= i (array-length src)) dst]
        [else (array-push! dst (array-ref src i))
              (array-append!-from dst src (+ i 1))]))

;; ---------------------------------------------------------------- debug

;; *debug* is a variable, not a special form, so a program can rebind it and a
;; macro that reads it keeps working.
(def *debug* #f)
