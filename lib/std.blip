;; lib/std.blip -- the blip standard library, in blip.
;;
;; Loaded by `blip run` and by the REPL before your program, so a program does not
;; have to say `(require "std.blip")` for names everybody assumes exist. That is
;; the same rule every language with a prelude follows, and it is what lets the
;; examples in examples/ read the way they do: `(parse-in "key: value")` is a
;; call, not a definition the reader has to scroll past.
;;
;; Everything here is ordinary blip. There is no special form in this file, which
;; is the point: if the standard library needs a new feature, the feature is
;; missing rather than the library being special.
;;
;; The Result-returning names are the convention the language settles on: a
;; function that can fail for an expected reason returns `(ok v)` or `(err 'why)`,
;; and `use` binds the values without a staircase. A function that fails for an
;; impossible reason calls `raise`.

;; ---------------------------------------------------------------- results

(def (identity x) x)

;; err-message reads the message out of an `(err msg)` value. `raise` builds one
;; and `try`'s #:catch matches against it, so this is how a handler reads what
;; went wrong.
(def (err-message e)
  (assert (err? e) "err-message needs an (err ...) value")
  (get e 1))

;; The Result combinators are ordinary blip. The machine keeps only
;; construction and observation (`ok`, `err`, `ok?`, `err?`, `ok-value`,
;; `err-value`); everything that maps over a Result is defined here, so both
;; engines run the same code. A non-Result passes through `map-result` and
;; `flatten-result` untouched, exactly as the machine builtins did: only an
;; `(ok _)` is mapped, only an `(err _)` is an error.

;; map-result turns (ok v) into (ok (f v)) and passes anything else through
;; untouched -- including an (err _) from f itself, which is returned as is
;; rather than wrapped.
(def (map-result r f)
  (if (ok? r)
      (let ([v (f (ok-value r))])
        (if (err? v) v (ok v)))
      r))

;; unwrap-or takes the value out, or the fallback when there is none. The
;; parameter is not named `default`: that is a reserved word in JavaScript,
;; and the emitter compiles this file too.
(def (unwrap-or r fallback)
  (if (ok? r) (ok-value r) fallback))

;; flatten-result peels one level: (ok (ok 1)) is (ok 1), and so is
;; (ok (err 'inner))'s inner. Anything else is already flat.
(def (flatten-result r)
  (if (ok? r)
      (let ([inner (ok-value r)])
        (if (ok? inner) inner (if (err? inner) inner r)))
      r))

;; all-results collects every value into a vector, or returns the first
;; error. The walk is quadratic in the number of results -- vector-append
;; copies -- which is the price of building a vector without `apply`, and
;; `apply` does not splice under node the way the machine splices.
(def (all-results . rs)
  (all-results-from rs (vector)))

;; all-results-from is the carrying half of all-results, kept under its own
;; name so the name a program writes stays the name that reads well.
(def (all-results-from rs acc)
  (if (null? rs)
      (ok acc)
      (let ([first (car rs)])
        (if (ok? first)
            (all-results-from (cdr rs) (vector-append acc (vector (ok-value first))))
            first))))

;; lazy-unwrap runs the thunk only on err: the default is computed nowhere
;; else, because in a Lisp every argument is evaluated eagerly.
(def (lazy-unwrap r thunk)
  (if (ok? r) (ok-value r) (thunk)))

;; lazy-map-result maps over an (ok _) and passes an (err _) straight
;; through, like map-result. The name states the intent at the call site.
(def (lazy-map-result r f)
  (map-result r f))

;; ---------------------------------------------------------------- strings
;; Padding is spaces, to a width, never truncating: a value longer than the
;; width is already aligned. `pad` pads on the right (columns read left to
;; right); `pad-left` pads on the left (numbers line up).

;; pad pads on the right with spaces.
(def (pad s width)
  (if (<= (string-length s) width)
      (string-append s (string-repeat " " (- width (string-length s))))
      s))

;; pad-left pads on the left with spaces.
(def (pad-left s width)
  (if (<= (string-length s) width)
      (string-append (string-repeat " " (- width (string-length s))) s)
      s))

;; ---------------------------------------------------------------- tables
;; Paths, merges, and subsets. `get` is total (nil on a miss) and
;; `table-keys` lists every key, so the rest is ordinary blip: `get-in`
;; walks a path of keys, `merge` overlays left to right with later keys
;; winning, `select-keys` keeps a subset, and `vals` reads every value in
;; key order. Paths and key sets read naturally as vectors, so a small
;; `as-list` normalizes them once instead of every caller checking twice.

;; as-list turns a vector into a list of its elements; lists pass through.
(def (as-list xs)
  (if (vector? xs)
      (as-list-from xs 0 (vector-length xs))
      xs))

;; as-list-from is the index-carrying half of as-list.
(def (as-list-from xs i n)
  (if (= i n)
      nil
      (cons (vector-ref xs i) (as-list-from xs (+ i 1) n))))

;; get-in follows a path of keys, answering nil the moment a step misses
;; or leaves the tables: a missing key and a wrong turn are both absence.
(def (get-in tbl path)
  (get-in-at tbl (as-list path)))

;; get-in-at is the walking half of get-in.
(def (get-in-at t ks)
  (if (null? ks)
      t
      (if (table? t)
          (let ([v (get t (car ks))])
            (if (nil? v) nil (get-in-at v (cdr ks))))
          nil)))

;; merge overlays tables left to right; later keys win. No tables is {},
;; one table is itself.
(def (merge-two a b)
  (fold (fn [acc k] (put acc k (get b k))) a (table-keys b)))

(def (merge . ts)
  (fold merge-two {} ts))

;; select-keys keeps the named keys that exist; absent ones are skipped,
;; not errors, because a subset that fails on a missing key is a lookup,
;; not a subset.
(def (select-keys t ks)
  (select-keys-from t (as-list ks) {}))

;; select-keys-from is the carrying half of select-keys.
(def (select-keys-from t ks acc)
  (if (null? ks)
      acc
      (if (has-key? t (car ks))
          (select-keys-from t (cdr ks) (put acc (car ks) (get t (car ks))))
          (select-keys-from t (cdr ks) acc))))

;; vals reads every value in key order (table-keys sorts), so the answer
;; is deterministic whatever order the table was built in.
(def (vals t)
  (map (fn [k] (get t k)) (table-keys t)))

;; ---------------------------------------------------------------- csv
;; Promoted from programs/csv_to_table.blip, which keeps its demo and its
;; asserts: the file that proved the code is the file that still runs it.
;; A CSV file becomes a vector of tables, one per row, with the header row
;; as keys. Nothing aborts: a short row, a blank line or a missing file is
;; a value.

;; split-line splits one comma-separated line.
(def (split-line line)
  (string-split line ","))

;; trim-cell trims one cell.
(def (trim-cell s) (string-trim s))

;; csv-rows splits text into non-blank lines.
(def (csv-rows text)
  (filter (fn [l] (not (string-blank? l)))
          (string-split text "\n")))

;; header-row reads the header names off the first line.
(def (header-row lines)
  (map trim-cell (split-line (list-ref lines 0))))

;; row->table folds one row into a table: missing cells are nil, so a
;; short row is a sparse row, not an error.
(def (row->table header cells)
  (fold (fn [acc i]
          (put acc (list-ref header i)
               (if (< i (length cells))
                   (trim-cell (list-ref cells i))
                   nil)))
        {}
        (range 0 (- (length header) 1))))

;; csv->table reads the whole text: header plus one table per data row.
(def (csv->table text)
  (let lines (csv-rows text)
    (if (= (length lines) 0)
        (vector)
        (let header (header-row lines)
          (map (fn [line]
                 (row->table header (split-line line)))
               (cdr lines))))))

;; ---------------------------------------------------------------- fs
;; Promoted from programs/config.blip, which keeps its demo: key: value
;; config files and the temp dir they stage in. `read-file`/`write-file`
;; stay prims (only the machine touches the OS); what is ordinary blip
;; about files -- splitting, folding, skipping blanks -- lives here.

;; parse-line reads one "key: value" line: (ok key value), or (ok nil nil)
;; for a blank line, which is nothing rather than an error.
(def (parse-line line)
  (if (string-blank? line)
      (ok nil nil)
      (use (parse-in line)
        (ok r1 r2))))

;; read-config folds a key: value file into a table. A read failure stops
;; the whole thing -- there is no config to fold -- and a malformed line
;; is an error naming it.
(def (read-config path)
  (let res (read-file path)
    (if (err? res)
        res
        (let lines (string-split (ok-value res) "\n")
          (fold (fn [acc line]
                  (use (parse-line line)
                    (if (nil? r1)
                        acc
                        (put acc r1 r2))))
                {}
                lines)))))

;; tmp-dir answers a scratch directory: TEMP, then TMP (Windows
;; conventions), else /tmp. An unset variable is nil, which is truthy
;; here, so unset-ness is tested with `nil?`, never `or`.
(def (tmp-dir)
  (if (nil? (env "TEMP"))
      (if (nil? (env "TMP")) "/tmp" (env "TMP"))
      (env "TEMP")))

;; ---------------------------------------------------------------- time
;; `now` is unix seconds as an integer. The clock is not ordinary blip --
;; nothing in this file could read it -- so it is a prim, wired through
;; the emitter like every other one. `elapsed` answers whole seconds
;; since a `now` value.

;; elapsed answers whole seconds since start.
(def (elapsed start)
  (- (now) start))

;; ---------------------------------------------------------------- json
;; Promoted from programs/json.blip, which keeps its driver and its
;; asserts: the file that proved the code is the file that still runs it.
;; Values: objects become tables with string keys, arrays become vectors,
;; strings/numbers/booleans map to themselves, null is nil. Positions are
;; integer indexes; every parse function returns `(ok value pos)` or
;; `(err reason pos)`. Nothing on the parse path raises.

;; json-code is the byte at `pos`, or -1 past the end. One place, so the
;; past-the-end rule cannot drift between callers.
(def (json-code text pos)
  (if (>= pos (length text))
      -1
      (rune->integer (string->rune (string-slice text pos (+ pos 1))))))

(def (json-space? code)
  (or (= code 32) (= code 9) (= code 10) (= code 13)))

(def (json-skip-ws text pos)
  (if (json-space? (json-code text pos))
      (json-skip-ws text (+ pos 1))
      pos))

(def (json-digit? code)
  (and (>= code 48) (<= code 57)))

;; --- strings ---

(def (json-hex code)
  (cond [(and (>= code 48) (<= code 57)) (- code 48)]
        [(and (>= code 97) (<= code 102)) (+ (- code 97) 10)]
        [(and (>= code 65) (<= code 70)) (+ (- code 65) 10)]
        [else -1]))

;; json-unicode reads four hex digits at `pos`: (ok code pos-after).
(def (json-unicode text pos)
  (let d1 (json-hex (json-code text pos))
    (let d2 (json-hex (json-code text (+ pos 1)))
      (let d3 (json-hex (json-code text (+ pos 2)))
        (let d4 (json-hex (json-code text (+ pos 3)))
          (if (or (< d1 0) (< d2 0) (< d3 0) (< d4 0))
              (err 'bad-unicode pos)
              (ok (+ (* d1 4096) (* d2 256) (* d3 16) d4) (+ pos 4))))))))

;; json-escape resolves the escape at `pos` (just past the backslash),
;; pushing the decoded character and continuing the string.
(def (json-escape text pos acc)
  (let code (json-code text pos)
    (cond [(= code 34) (json-string-tail text (+ pos 1) (array-push! acc "\""))]
          [(= code 92) (json-string-tail text (+ pos 1) (array-push! acc "\\"))]
          [(= code 47) (json-string-tail text (+ pos 1) (array-push! acc "/"))]
          [(= code 98) (json-string-tail text (+ pos 1) (array-push! acc (code->string 8)))]
          [(= code 102) (json-string-tail text (+ pos 1) (array-push! acc (code->string 12)))]
          [(= code 110) (json-string-tail text (+ pos 1) (array-push! acc "\n"))]
          [(= code 114) (json-string-tail text (+ pos 1) (array-push! acc "\r"))]
          [(= code 116) (json-string-tail text (+ pos 1) (array-push! acc "\t"))]
          [(= code 117) (use (json-unicode text (+ pos 1))
                          (json-string-tail text r2 (array-push! acc (code->string r1))))]
          [else (err 'bad-escape pos)])))

;; json-string-tail walks from `pos` (just past the opening quote),
;; collecting one-character strings into `acc`, until the closing quote.
;; The accumulator plus one join keeps this linear rather than quadratic.
(def (json-string-tail text pos acc)
  (let code (json-code text pos)
    (cond [(= code -1) (err 'unterminated-string pos)]
          [(= code 34) (ok (string-join acc "") (+ pos 1))]
          [(= code 92) (json-escape text (+ pos 1) acc)]
          [(< code 32) (err 'control-char pos)]
          [else (json-string-tail text (+ pos 1)
                  (array-push! acc (string-slice text pos (+ pos 1))))])))

(def (json-parse-string text pos)
  (json-string-tail text (+ pos 1) (vector)))

;; --- numbers ---
;;
;; Grammar: -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)? -- checked by hand
;; because `string->number` answers nil for garbage instead of saying where,
;; and "where" is what an (err reason pos) owes its caller.

(def (json-numchar? code)
  (or (= code 45) (= code 43) (= code 46)
      (= code 101) (= code 69)
      (json-digit? code)))

(def (json-scan-number text pos)
  (if (json-numchar? (json-code text pos))
      (json-scan-number text (+ pos 1))
      pos))

;; json-digits1 skips one or more digits, or -1 when there are none.
(def (json-digits1 token pos end)
  (if (or (>= pos end) (not (json-digit? (json-code token pos))))
      -1
      (json-digits token (+ pos 1) end)))

(def (json-digits token pos end)
  (if (or (>= pos end) (not (json-digit? (json-code token pos))))
      pos
      (json-digits token (+ pos 1) end)))

(def (json-int-start token end)
  (let p (if (= (json-code token 0) 45) 1 0)
    (if (>= p end)
        -1
        (if (= (json-code token p) 48)
            (+ p 1)
            (json-digits1 token p end)))))

(def (json-frac-part token pos end)
  (if (or (>= pos end) (not= (json-code token pos) 46))
      pos
      (json-digits1 token (+ pos 1) end)))

(def (json-e? code)
  (or (= code 101) (= code 69)))

(def (json-exp-part token pos end)
  (if (or (>= pos end) (not (json-e? (json-code token pos))))
      pos
      (let q (+ pos 1)
        (let r (if (or (= (json-code token q) 43) (= (json-code token q) 45))
                   (+ q 1)
                   q)
          (json-digits1 token r end)))))

(def (json-valid-number? token)
  (let end (string-length token)
    (let p1 (json-int-start token end)
      (if (< p1 0)
          #f
          (let p2 (json-frac-part token p1 end)
            (if (< p2 0)
                #f
                (= (json-exp-part token p2 end) end)))))))

(def (json-parse-number text pos)
  (let end (json-scan-number text pos)
    (let token (string-slice text pos end)
      (if (json-valid-number? token)
          (let n (string->number token)
            (if (nil? n)
                (err 'bad-number pos)
                (ok n end)))
          (err 'bad-number pos)))))

;; --- literals ---

(def (json-word? text pos word)
  (let end (+ pos (string-length word))
    (if (> end (string-length text))
        #f
        (= (string-slice text pos end) word))))

(def (json-parse-literal text pos)
  (cond [(json-word? text pos "true") (ok #t (+ pos 4))]
        [(json-word? text pos "false") (ok #f (+ pos 5))]
        [(json-word? text pos "null") (ok nil (+ pos 4))]
        [else (err 'unexpected-char pos)]))

;; --- arrays ---

(def (json-parse-array text pos)
  (json-array-items text (+ pos 1) (vector) #t))

;; `first?` is whether `]` may close the array here: it may for `[] but not
;; after a comma, where `[1,]` must fail rather than parse as `[1]`.
(def (json-array-items text pos acc first?)
  (let p (json-skip-ws text pos)
    (if (and first? (= (json-code text p) 93))
        (ok acc (+ p 1))
        (use (json-parse-value text p)
          (let q (json-skip-ws text r2)
            (cond [(= (json-code text q) 44)
                   (json-array-items text (+ q 1) (array-push! acc r1) #f)]
                  [(= (json-code text q) 93)
                   (ok (array-push! acc r1) (+ q 1))]
                  [else (err 'expected-comma-or-bracket q)]))))))

;; --- objects ---
;;
;; The nested `use` rebinds r1/r2, so the key is stashed in a `let` first:
;; lexical bindings survive what `use` rebinds.

(def (json-parse-object text pos)
  (json-object-items text (+ pos 1) {} #t))

;; `first?` is whether `}` may close the object here: it may for `{}` but not
;; after a comma, where `{"a":1,}` must fail rather than parse as `{"a":1}`.
(def (json-object-items text pos acc first?)
  (let p (json-skip-ws text pos)
    (if (and first? (= (json-code text p) 125))
        (ok acc (+ p 1))
        (if (not= (json-code text p) 34)
            (err 'expected-string-key p)
            (use (json-parse-string text p)
              (let key r1
                (let q (json-skip-ws text r2)
                  (if (not= (json-code text q) 58)
                      (err 'expected-colon q)
                      (use (json-parse-value text (json-skip-ws text (+ q 1)))
                        (let v r1
                          (let r (json-skip-ws text r2)
                            (cond [(= (json-code text r) 44)
                                   (json-object-items text (+ r 1) (put acc key v) #f)]
                                  [(= (json-code text r) 125)
                                   (ok (put acc key v) (+ r 1))]
                                  [else (err 'expected-comma-or-brace r)]))))))))))))

;; --- values + entry ---

(def (json-parse-value text pos)
  (let p (json-skip-ws text pos)
    (let code (json-code text p)
      (cond [(= code 123) (json-parse-object text p)]
            [(= code 91) (json-parse-array text p)]
            [(= code 34) (json-parse-string text p)]
            [(= code 116) (json-parse-literal text p)]
            [(= code 102) (json-parse-literal text p)]
            [(= code 110) (json-parse-literal text p)]
            [(= code 45) (json-parse-number text p)]
            [(json-digit? code) (json-parse-number text p)]
            [(= code -1) (err 'unexpected-end p)]
            [else (err 'unexpected-char p)]))))

(def (json-parse text)
  (use (json-parse-value text 0)
    (let end (json-skip-ws text r2)
      (if (= end (string-length text))
          (ok r1)
          (err 'trailing-garbage end)))))

;; --- emit ---

(def json-hex-digits "0123456789abcdef")

(def (json-hex2 code)
  (string-append (string-slice json-hex-digits (/ code 16) (+ (/ code 16) 1))
                 (string-slice json-hex-digits (modulo code 16) (+ (modulo code 16) 1))))

(def (json-piece ch code)
  (cond [(= code 34) "\\\""]
        [(= code 92) "\\\\"]
        [(= code 10) "\\n"]
        [(= code 9) "\\t"]
        [(= code 13) "\\r"]
        [(= code 8) "\\b"]
        [(= code 12) "\\f"]
        [(< code 32) (string-append "\\u00" (json-hex2 code))]
        [else ch]))

(def (json-string-pieces s i acc)
  (if (>= i (string-length s))
      (array-push! acc "\"")
      (let ch (string-slice s i (+ i 1))
        (let code (rune->integer (string->rune ch))
          (json-string-pieces s (+ i 1) (array-push! acc (json-piece ch code)))))))

(def (json-emit-string s)
  (string-join (json-string-pieces s 0 (array-push! (vector) "\"")) ""))

(def (json-emit-items v i acc)
  (if (>= i (length v))
      acc
      (json-emit-items v (+ i 1) (array-push! acc (json-emit (vector-ref v i))))))

(def (json-emit-array v)
  (string-append "[" (string-append (string-join (json-emit-items v 0 (vector)) ",") "]")))

;; table-keys answers keywords; `str` renders one with its colon, which is
;; sliced off. One conversion, in one place.
(def (json-key-string k)
  (let s (str k)
    (string-slice s 1 (string-length s))))

(def (json-emit-pairs v keys i acc)
  (if (>= i (length keys))
      acc
      (let k (json-key-string (get keys i))
        (json-emit-pairs v keys (+ i 1)
          (array-push! acc (string-append (json-emit-string k)
                             (string-append ":" (json-emit (get v k)))))))))

(def (json-emit-object v)
  (string-append "{" (string-append (string-join (json-emit-pairs v (table-keys v) 0 (vector)) ",") "}")))

;; Emitting a non-JSON value is a caller bug, not a parse failure, so it
;; raises: `err` is for inputs the world handed us, `raise` is for contracts
;; we broke ourselves.
(def (json-emit v)
  (cond [(string? v) (json-emit-string v)]
        [(integer? v) (number->string v)]
        [(float? v) (number->string v)]
        [(boolean? v) (if v "true" "false")]
        [(nil? v) "null"]
        [(vector? v) (json-emit-array v)]
        [(table? v) (json-emit-object v)]
        [else (raise (error "json-emit: cannot encode ~a" v))]))

;; ---------------------------------------------------------------- seq
;; Zipping, indexing, and chunking. These take lists and answer lists;
;; the polymorphic builtins (`map`, `filter`) already serve every
;; container, and these fill the missing shapes, not a second copy of
;; them. A `keep` is deliberately absent: v2 removed it as a duplicate
;; of `filter`, and `(def keep filter)` in your own file is the alias
;; recipe -- the core and the std carry one spelling each.

;; zip stops at the shorter input: no padding, no silent miss.
(def (zip a b)
  (if (null? a)
      (list)
      (if (null? b)
          (list)
          (cons (list (car a) (car b)) (zip (cdr a) (cdr b))))))

;; enumerate pairs each element with its index from 0, so the result
;; reads with `car`/`cadr` exactly like `frequencies` pairs do.
(def (enumerate xs)
  (enumerate-from xs 0))

;; enumerate-from is the index-carrying half of enumerate, kept under its
;; own name so the name a program writes stays the name that reads well.
(def (enumerate-from xs n)
  (if (null? xs)
      (list)
      (cons (list n (car xs)) (enumerate-from (cdr xs) (+ n 1)))))

;; partition chunks a list into n-sized pieces, keeping a short tail:
;; dropping it would lose data silently. A non-positive size is a bug,
;; not a result, so it raises.
(def (partition n xs)
  (if (<= n 0)
      (raise (error "partition needs a positive size"))
      (if (null? xs)
          (list)
          (cons (take xs n) (partition n (drop xs n))))))

;; ---------------------------------------------------------------- parsing

;; parse-in reads "key: value" and returns (ok key value). It is the smallest
;; honest demonstration of a multi-value Result, which is what `use` exists for.
(def (parse-in text)
  ;; `assert`, not `let assert`. `let assert [PATTERN VALUE] body` matches a
  ;; PATTERN against a VALUE, and `(string? text)` binds `text` from the subject
  ;; rather than testing the parameter -- so it never tests anything and the body
  ;; referred to a name nothing had bound.
  (assert (string? text) "parse-in needs a string")
  (let parts (string-split text ":")
    (cond [(= (length parts) 2) (ok (string-trim (list-ref parts 0))
                                    (string-trim (list-ref parts 1)))]
          [else (err 'malformed)])))

;; ---------------------------------------------------------------- symbols

;; lookup-sym finds a name in a small table of symbols. `nil` means absent, which
;; is what match* wants to tell apart from a found-and-wrong value.
(def (lookup-sym name)
  (cond [(equal? name 'alpha) (ok 'alpha)]
        [(equal? name 'beta) (ok 'beta)]
        [else nil]))

;; validate says whether a looked-up symbol is usable.
(def (validate name)
  (cond [(equal? name 'alpha) (ok nil)]
        [(equal? name 'beta) (err 'unknown-symbol)]
        [else (err 'unknown-symbol)]))

;; ---------------------------------------------------------------- resources

;; A connection is a table, so a test can build one by hand and a program can
;; inspect one. A struct would be better once modules can hide constructors; a
;; table is honest about how little this is.
(def (connect target)
  (cond [(string-not-blank? target) (ok {:host target :session nil})]
        [else (err 'bad-target)]))

(def (authenticate conn :user [user "anonymous"] :pass [pass ""])
  (cond [(equal? user "anonymous") (err 'no-credentials)]
        [(not (equal? pass "s3cret")) (err 'bad-password)]
        [else (ok conn)]))

(def (open-transaction conn)
  (cond [(nil? (get conn :session)) (err 'not-authenticated)]
        [else (ok conn)]))

(def (execute conn sql)
  (cond [(nil? (get conn :session)) (err 'not-authenticated)]
        [else (ok sql)]))

(def (commit conn)
  (cond [(nil? (get conn :session)) (err 'not-authenticated)]
        [else (ok 'committed)]))

;; ---------------------------------------------------------------- arrays

;; array-append! pushes every element of src onto the end of dst, in order, and
;; returns dst. `array-push!` adds ONE value per call, so appending a whole array
;; is an iteration over src's indexes -- which is all this wrapper is, walking
;; the indexes with a tail call rather than a `loop` form, because the prelude is
;; also compiled by the JS emitter and a `loop` there is refused by name.
(def (array-append! dst src)
  (array-append!-from dst src 0))

;; The index-carrying half of `array-append!`, kept under its own name so the
;; name a program writes stays the name that reads well at the call site.
(def (array-append!-from dst src i)
  (cond [(= i (array-length src)) dst]
        [else (array-push! dst (array-ref src i))
              (array-append!-from dst src (+ i 1))]))

;; ---------------------------------------------------------------- debug

;; *debug* is a variable, not a special form, so a program can rebind it and a
;; macro that reads it keeps working.
(def *debug* #f)
