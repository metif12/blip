# blip build artifacts
*.exe
*.dll
*.so
*.dylib
*.o
*.obj
*.a

# V intermediate output
*.vgen
*.vtmp

# NOT ignored: vlib/blip/ holds the blip implementation itself.
# Only V's own generated vlib/ (dependencies fetched by `v`) is excluded.

# Editor
.vscode/
.idea/
*.swp
.DS_Store
# Test and probe binaries built during development
tools/*.exe
tmp/
tests/out.txt

# Generated website: rebuilt by `blip run site/build.lip`, never edited.
site_out/
tools/*.exe
*.exe
*.tar.gz
SHA256SUMS
dist/

# Installed packages: recorded in blip.lock, restored by `blip pkg install`.
blip_modules/


# V's per-build cache directories. The compiler drops these beside the binary
# it produces; they are build state, not source.
*.v3cc*/
