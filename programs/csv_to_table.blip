;; programs/csv_to_table.blip -- CSV to table, the roadmap's third program.
;;
;; The first program that forces file I/O into existence. A CSV file becomes
;; a vector of tables, one per row, with the header row as keys. Nothing
;; aborts: a short row, a blank line or a missing file is a value.
;;
;; The parsing itself lives in lib/std.blip (split-line, trim-cell,
;; csv-rows, header-row, row->table, csv->table); what stays here is the
;; demo that proves it, plus the short-row assert.

;; ---------------------------------------------------------------- demo
(let sample "name,age,city\nalice,30,paris\nbob,25,\n"
  (let t (csv->table sample)
    (begin
      (println "rows:" (length t))
      (println "first name:" (get (get t 0) "name"))
      (println "first age:" (get (get t 0) "age"))
      (println "second city:" (get (get t 1) "city"))
      (println "csv ok"))))

;; A short row does not crash: missing cells are nil.
(let t2 (csv->table "a,b\n1\n")
  (println "short row ok:" (nil? (get (get t2 0) "b"))))