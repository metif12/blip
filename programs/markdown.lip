;; programs/markdown.lip -- Markdown to HTML in blip.
;;
;; Third on the roadmap's real-program list. Exercises lists, higher-order
;; functions and string building. Nothing aborts: malformed input renders
;; as text.

(define (md-trim s) (string-trim s))

(define (md-blank? s) (string-blank? s))

(define (md-starts-with s prefix)
  (= (string-slice s 0 (string-length prefix)) prefix))

;; ---------------------------------------------------------------- inline

(define (md-inline-code s)
  (let idx (string-index-of s "`")
    (if (< idx 0)
      s
      (let rest (string-slice s (+ idx 1) (string-length s))
        (let close (string-index-of rest "`")
          (if (< close 0)
            s
            (string-append (string-slice s 0 idx)
              (string-append "<code>"
                (string-append (string-slice rest 0 close)
                  (string-append "</code>"
                    (md-inline-code (string-slice rest (+ close 1) (string-length rest)))))))))))))

(define (md-bold s)
  (let idx (string-index-of s "**")
    (if (< idx 0)
      s
      (let rest (string-slice s (+ idx 2) (string-length s))
        (let close (string-index-of rest "**")
          (if (< close 0)
            s
            (string-append (string-slice s 0 idx)
              (string-append "<strong>"
                (string-append (string-slice rest 0 close)
                  (string-append "</strong>"
                    (md-bold (string-slice rest (+ close 2) (string-length rest)))))))))))))

(define (md-italic s)
  (let idx (string-index-of s "*")
    (if (< idx 0)
      s
      (let rest (string-slice s (+ idx 1) (string-length s))
        (let close (string-index-of rest "*")
          (if (< close 0)
            s
            (string-append (string-slice s 0 idx)
              (string-append "<em>"
                (string-append (string-slice rest 0 close)
                  (string-append "</em>"
                    (md-italic (string-slice rest (+ close 1) (string-length rest)))))))))))))

(define (md-link s)
  (let idx (string-index-of s "[")
    (if (< idx 0)
      s
      (let rest (string-slice s (+ idx 1) (string-length s))
        (let close (string-index-of rest "]")
          (if (< close 0)
            s
            (let url-part (string-slice rest (+ close 1) (string-length rest))
              (if (or (< (string-length url-part) 2)
                      (not= (string-slice url-part 0 1) "("))
                s
                (let url-close (string-index-of url-part ")")
                  (if (< url-close 0)
                    s
                    (string-append (string-slice s 0 idx)
                      (string-append "<a href=\""
                        (string-append (string-slice url-part 1 url-close)
                          (string-append "\">"
                            (string-append (string-slice rest 0 close)
                              (string-append "</a>"
                                (md-link (string-slice url-part (+ url-close 1) (string-length url-part)))))))))))))))))))

(define (md-inline s)
  (md-link (md-italic (md-bold (md-inline-code s)))))

;; ---------------------------------------------------------------- blocks

(define (md-hash-count line i)
  (if (>= i (string-length line))
    i
    (if (= (rune->integer (string->rune (string-slice line i (+ i 1)))) 35)
      (md-hash-count line (+ i 1))
      i)))

(define (md-render-heading line)
  (let n (md-hash-count line 0)
    (let text (md-trim (string-slice line n (string-length line)))
      (string-append (string-append "<h" (number->string n))
        (string-append ">"
          (string-append (md-inline text)
            (string-append "</h" (string-append (number->string n) ">"))))))))

(define (md-is-heading line)
  (and (> (string-length line) 0)
       (= (rune->integer (string->rune (string-slice line 0 1))) 35)))

(define (md-is-hr line)
  (let t (md-trim line)
    (or (= t "---") (= t "***") (= t "___"))))

(define (md-is-ul line)
  (and (>= (string-length line) 2)
       (= (rune->integer (string->rune (string-slice line 0 1))) 45)
       (= (rune->integer (string->rune (string-slice line 1 2))) 32)))

(define (md-render-ul-item line)
  (string-append "<li>" (string-append (md-inline (md-trim (string-slice line 2 (string-length line)))) "</li>")))

(define (md-code-fence? line)
  (md-starts-with (md-trim line) "```"))

;; ---------------------------------------------------------------- driver

(define (md-render-line line)
  (cond
    [(md-blank? line) ""]
    [(md-is-heading line) (md-render-heading line)]
    [(md-is-hr line) "<hr>"]
    [(md-is-ul line) (string-append "<ul><li>" (string-append (md-inline (md-trim (string-slice line 2 (string-length line)))) "</li></ul>"))]
    [(md-code-fence? line) "<pre><code>"]
    [else (string-append "<p>" (string-append (md-inline line) "</p>"))]))

(define (md-render lines)
  (md-render-list (as-lines lines) #f))

;; Fences need state: a ``` line opens <pre><code> or closes it, and lines
;; inside a fence render verbatim (HTML-escaped) instead of as markdown.
;; `car`/`cdr` only take pairs, so the driver walks a list; `as-lines`
;; normalizes vectors the same way (`apply` splices any sequence).
(define (as-lines xs)
  (if (vector? xs) (apply list xs) xs))

(define (md-render-list lines in-fence)
  (if (null? lines)
    (if in-fence "</code></pre>" "")
    (let line (car lines)
      (let rest (md-render-list (cdr lines)
                  (if (md-code-fence? line) (not in-fence) in-fence))
        (if (md-code-fence? line)
          (if in-fence
            (string-append "</code></pre>" rest)
            (string-append "<pre><code>" rest))
          (string-append (if in-fence (html-escape line) (md-render-line line))
            (string-append "\n" rest)))))))

;; ---------------------------------------------------------------- self tests

(assert (= (md-inline-code "use `x` here") "use <code>x</code> here") "inline code")
(assert (= (md-bold "a **b** c") "a <strong>b</strong> c") "bold")
(assert (= (md-italic "a *b* c") "a <em>b</em> c") "italic")
(assert (= (md-link "see [x](u) now") "see <a href=\"u\">x</a> now") "link")
(assert (= (md-is-heading "# hi") #t) "heading detect")
(assert (= (md-render-heading "# hi") "<h1>hi</h1>") "heading render")
(assert (= (md-is-hr "---") #t) "hr detect")
(assert (= (md-is-ul "- item") #t) "ul detect")
(assert (= (md-render (vector "```" "(+ 1 2)" "```")) "<pre><code>(+ 1 2)\n</code></pre>") "fence render")
(assert (= (md-render (list "```" "a <b>" )) "<pre><code>a &lt;b&gt;\n</code></pre>") "unclosed fence escapes")

(let html (md-render (vector "# Title" "" "Hello **world**." "- a" "- b"))
  (begin
    (assert (string-contains? html "<h1>Title</h1>") "render heading")
    (assert (string-contains? html "<strong>world</strong>") "render bold")
    (assert (string-contains? html "<li>a</li>") "render list")
    (print "markdown ok")))
